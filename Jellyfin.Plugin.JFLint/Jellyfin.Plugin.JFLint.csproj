<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net9.0 is not a preference but a constraint: Jellyfin 10.11 runs on the .NET 9
         runtime and cannot load a net10.0 assembly. net10.0 targets the v12 line. -->
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <RootNamespace>Jellyfin.Plugin.JFLint</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>false</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Reproducible artifacts. Without these two, every commit produced a different DLL -
         including commits that only touched the README - which silently invalidated the
         checksum of an already published release.
         Two separate channels, both measured:
           1. The SDK appends the HEAD commit to AssemblyInformationalVersion
              (11.1.0.0+ff5052f0... vs 11.1.0.0+f1fc48e5...) -> lands in the assembly.
           2. SourceLink writes a map containing the HEAD commit into the PDB, and the
              assembly carries its PDB's checksum in the debug directory -> the DLL bytes
              change even though the sha itself is not in the DLL.
         Turning off the SCM queries kills both at the root. The PDB is still shipped, it
         just no longer points back at a specific commit. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <!-- ContinuousIntegrationBuild, the usual "reproducible build" switch, does nothing
         here - measured: identical hash, obj path still in the debug directory. It
         normalises paths via SourceRoot, which the SCM queries above supply, and those are
         off. PathMap does the same job without needing them: it rewrites the build
         directory to a fixed placeholder, so a clone at any other path produces the same
         bytes. Verified by building the same source from two different directories. -->
    <PathMap>$(MSBuildProjectDirectory)=/_/</PathMap>
    <AnalysisMode>AllEnabledByDefault</AnalysisMode>
    <!-- Jellyfin's own ruleset, taken verbatim from jellyfin-plugin-template. It turns
         off the StyleCop rules that contradict Jellyfin's house style (usings outside
         the namespace, no file headers, no 'this.' prefix) and sharpens six CA rules to
         Error. Everything not listed there still fails the build. -->
    <CodeAnalysisRuleSet>$(MSBuildThisFileDirectory)..\jellyfin.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>

  <!-- ControllerBase, [ApiController], [Authorize]. The server hosts ASP.NET Core; the
       plugin only compiles against it. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- The major version encodes the Jellyfin line this build belongs to: 11.x for
       Jellyfin 10.11, 12.x for Jellyfin 12. Two reasons this matters beyond being a
       mnemonic. First, no version number may appear twice in the repository manifest -
       Jellyfin filters by targetAbi and then takes the highest version, so identical
       numbers would be decided by array order alone. Second, a server upgrading from
       10.11 to 12 sees 12.1.0.0 > 11.1.0.0 and is offered the matching build as an
       update; with equal numbers it would silently keep running the net9.0 assembly.
       Bump the third part for fixes within a line. -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <Version>11.3.0.0</Version>
    <AssemblyVersion>11.3.0.0</AssemblyVersion>
    <FileVersion>11.3.0.0</FileVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <Version>12.3.0.0</Version>
    <AssemblyVersion>12.3.0.0</AssemblyVersion>
    <FileVersion>12.3.0.0</FileVersion>
  </PropertyGroup>

  <!-- ExcludeAssets="runtime": the server ships these assemblies itself, the plugin
       must not place copies next to its own DLL. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <PackageReference Include="Jellyfin.Controller" Version="10.11.11" ExcludeAssets="runtime" />
    <PackageReference Include="Jellyfin.Model" Version="10.11.11" ExcludeAssets="runtime" />
    <PackageReference Include="Jellyfin.Database.Implementations" Version="10.11.11" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Jellyfin.Controller" Version="12.0.0-rc3" ExcludeAssets="runtime" />
    <PackageReference Include="Jellyfin.Model" Version="12.0.0-rc3" ExcludeAssets="runtime" />
    <PackageReference Include="Jellyfin.Database.Implementations" Version="12.0.0-rc3" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556" PrivateAssets="All" />
  </ItemGroup>

</Project>
